<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.trade.order.mapper.OrderAttributionMapper">
  <resultMap id="replay" type="com.lrj.trade.order.model.OrderAttributionReplay" autoMapping="false">
    <constructor><arg column="request_hash" javaType="java.lang.String"/><arg column="order_no" javaType="java.lang.String"/></constructor>
  </resultMap>
  <select id="replay" resultMap="replay" useCache="false">
    SELECT request_hash,order_no FROM tc_order_attribution
    WHERE tenant_id=#{tenant} AND actor_key=#{actorKey} AND operation=#{operation} AND request_key=#{requestKey}
  </select>
  <insert id="insert">
    INSERT INTO tc_order_attribution(tenant_id,order_id,order_no,actor_key,operation,request_key,request_hash,
      issuer,jti,member_id,quote_id,referral_ref,campaign_id,definition_version,token_hash,issued_at,expires_at,created_at)
    VALUES(#{tenant},#{order},#{orderNo},#{actorKey},#{operation},#{requestKey},#{requestHash},
      #{claim.issuer},#{claim.jti},#{claim.memberId},#{claim.quoteId},#{claim.referralRef},#{claim.campaignId},
      #{claim.definitionVersion},#{claim.tokenHash},#{claim.issuedAt},#{claim.expiresAt},#{now})
  </insert>
</mapper>
