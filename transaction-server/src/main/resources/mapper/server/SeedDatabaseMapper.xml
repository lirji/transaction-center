<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.trade.server.mapper.SeedDatabaseMapper">
  <!-- 显式字段映射和绑定参数；保留租户条件、行锁及原子更新，禁止字符串拼接。 -->


  <!-- 读取连接实际数据库名称，开发种子必须先通过隔离校验。 -->
  <select id="currentDatabase" resultType="java.lang.String" useCache="false">
    <![CDATA[
      SELECT DATABASE()
    ]]>
  </select>
</mapper>
