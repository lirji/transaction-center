{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "交易会员注册V1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "producer",
    "traceId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "trade.member-registered.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正十进制ID，数值不得超过9223372036854775807"
    },
    "aggregateType": {
      "const": "MEMBER"
    },
    "aggregateId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正十进制ID，数值不得超过9223372036854775807"
    },
    "aggregateVersion": {
      "const": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer": {
      "const": "transaction-center"
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "memberId",
        "registeredAt",
        "registrationSource"
      ],
      "additionalProperties": false,
      "properties": {
        "memberId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "正十进制ID，数值不得超过9223372036854775807"
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "registrationSource": {
          "const": "AUTHENTICATED_IDENTITY"
        }
      }
    }
  }
}
