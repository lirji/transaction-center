{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "交易正常收款V1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "producer",
    "traceId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "const": "trade.order-paid.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正十进制ID，数值不得超过9223372036854775807"
    },
    "aggregateType": {
      "const": "ORDER"
    },
    "aggregateId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正十进制ID，数值不得超过9223372036854775807"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer": {
      "const": "transaction-center"
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "orderId",
        "memberId",
        "receiptNo",
        "paidAmount",
        "currency",
        "paidAt",
        "firstOrderPolicy",
        "isFirstConfirmedPaidOrder",
        "evidenceVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "正十进制ID，数值不得超过9223372036854775807"
        },
        "memberId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "正十进制ID，数值不得超过9223372036854775807"
        },
        "receiptNo": {
          "type": "string",
          "pattern": "^RC-",
          "maxLength": 64
        },
        "paidAmount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "firstOrderPolicy": {
          "const": "FIRST_CONFIRMED_PAID_ORDER_V1"
        },
        "isFirstConfirmedPaidOrder": {
          "type": "boolean"
        },
        "evidenceVersion": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
