{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "refund-evidence V1",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "producer",
    "traceId",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "enum": [
        "trade.order-evidence-changed.v1",
        "trade.refund-succeeded.v1"
      ]
    },
    "schemaVersion": {
      "const": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正十进制ID，数值不得超过9223372036854775807"
    },
    "aggregateType": {
      "const": "ORDER"
    },
    "aggregateId": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "正十进制ID，数值不得超过9223372036854775807"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer": {
      "const": "transaction-center"
    },
    "traceId": {
      "type": "string",
      "format": "uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "orderId",
        "memberId",
        "refundNo",
        "refundAmount",
        "paidAmount",
        "cumulativeRefundedAmount",
        "pendingRefundAmount",
        "netPaidAmount",
        "conservativeEligibleAmount",
        "currency",
        "evidenceVersion",
        "changeReason"
      ],
      "additionalProperties": false,
      "properties": {
        "orderId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "正十进制ID，数值不得超过9223372036854775807"
        },
        "memberId": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "正十进制ID，数值不得超过9223372036854775807"
        },
        "refundNo": {
          "type": "string",
          "pattern": "^RF-",
          "maxLength": 64
        },
        "refundAmount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "paidAmount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cumulativeRefundedAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pendingRefundAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "netPaidAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "conservativeEligibleAmount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "evidenceVersion": {
          "type": "integer",
          "minimum": 1
        },
        "changeReason": {
          "enum": [
            "REFUND_RESERVED",
            "REFUND_RELEASED",
            "REFUND_SUCCEEDED"
          ]
        }
      }
    }
  }
}
