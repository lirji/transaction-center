<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.trade.core.mapper.AuditMapper">
  <!-- 显式字段映射和绑定参数；保留租户条件、行锁及原子更新，禁止字符串拼接。 -->


  <!-- 追加操作证据，业务回滚时审计必须同时回滚。 -->
  <insert id="insertAudit">
    <![CDATA[
      INSERT INTO tc_operation_audit(tenant_id,actor_key,action,resource_type,resource_id,reason,before_version,after_version)
      VALUES (#{tenant},#{actorKey},#{action},#{resourceType},#{resourceId},#{reason},#{beforeVersion},#{afterVersion})
    ]]>
  </insert>
</mapper>
