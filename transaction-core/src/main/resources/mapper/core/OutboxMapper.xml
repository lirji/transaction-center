<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lrj.trade.core.mapper.OutboxMapper">
  <!-- 显式字段映射和绑定参数；保留租户条件、行锁及原子更新，禁止字符串拼接。 -->


  <!-- 只追加内部事件事实，必须参与调用方事务，不能视为已投递。 -->
  <insert id="insertEvent">
    <![CDATA[
      INSERT INTO tc_outbox(tenant_id,event_id,event_type,aggregate_id,payload)
      VALUES (#{tenant},#{eventId},#{eventType},#{aggregateId},JSON_OBJECT('resourceId',#{resourceId}))
    ]]>
  </insert>
  <!-- 完整V1载荷直接保存；业务身份各列均来自同一事件对象。 -->
  <insert id="insertV1Event">
    INSERT INTO tc_outbox(tenant_id,event_id,event_type,aggregate_id,payload)
    VALUES (#{tenant},#{eventId},#{eventType},#{aggregateId},#{payload})
  </insert>
</mapper>
