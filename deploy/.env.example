# 复制为deploy/.env，填写现有交易专用账号；真实配置不得提交。
TRADE_DB_USER=
TRADE_DB_PASSWORD=
TRADE_MIGRATION_USER=
TRADE_MIGRATION_PASSWORD=
TRADE_JWT_ISSUER=
# 必须从容器内可达；localhost指容器自身。
TRADE_JWT_JWKS=
TRADE_JWT_AUDIENCE=transaction-center
DEV_INFRA_NETWORK=dev-infra
TRADE_HOST_PORT=8400
# 可选：共享Redis项目ACL配置，填好后再启用缓存。
TRADE_CATALOG_CACHE_ENABLED=false
TRADE_CATALOG_REDIS_USER=
TRADE_CATALOG_REDIS_PASSWORD=
# 可选worker事件发布；默认不向Kafka发送事件。
TRADE_OUTBOX_ENABLED=false
TRADE_OUTBOX_TOPIC_PREFIX=
# 演示库专用配置：只能对transaction_center_dev开启；参见scripts/prepare-demo-database.py。
TRADE_SPRING_PROFILES=

# 管理证据需额外scope；订单归因需可信签发方，默认保持关闭。
# 自动准入磁盘路径必须实际挂载数据库存储，配置为空时禁止启用。
TRADE_ADMIN_EVIDENCE_ENABLED=false
TRADE_ADMIN_QUERY_CONCURRENCY=4
TRADE_ADMIN_QUERY_TENANT_CONCURRENCY=2
TRADE_ADMIN_QUERY_TENANT_RATE=20
TRADE_ORDER_ATTRIBUTION_ENABLED=false
TRADE_ORDER_ATTRIBUTION_ISSUER=
TRADE_ORDER_ATTRIBUTION_JWKS=
TRADE_AUTOMATIC_ADMISSION_ENABLED=false
TRADE_AUTOMATIC_ADMISSION_DISK_PATH=
TRADE_AUTOMATIC_ADMISSION_DISK_STORE=
TRADE_AUTOMATIC_ADMISSION_BACKLOG_HIGH=10000
TRADE_AUTOMATIC_ADMISSION_BACKLOG_LOW=5000
TRADE_AUTOMATIC_ADMISSION_DISK_MIN_BYTES=5368709120
TRADE_AUTOMATIC_ADMISSION_DISK_RECOVERY_BYTES=10737418240
TRADE_AUTOMATIC_ADMISSION_INTERVAL_MILLIS=15000
TRADE_AUTOMATIC_ADMISSION_MAX_AGE_MILLIS=45000
